{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://technologywatch.test/schemas/source_profile.v1.schema.json",
  "title": "Source Profile v1",
  "description": "Versioned monitoring specification for one source (ADR-0005).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_key", "display_name", "profile_version", "status", "base_url",
    "allowed_hosts", "entrypoints", "document_patterns", "content_types", "parser_bindings",
    "quality_expectations", "crawl_policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_key": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["PENDING_APPROVAL", "ACTIVE", "SUPERSEDED", "REJECTED"] },
    "base_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "allowed_hosts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
    },
    "entrypoints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "url", "priority"],
        "properties": {
          "type": { "enum": ["rss", "atom", "sitemap", "sitemap_index", "index", "api"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }
        }
      }
    },
    "document_patterns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["include", "document_type"],
        "properties": {
          "include": { "type": "string", "minLength": 1 },
          "exclude": { "type": ["string", "null"] },
          "document_type": { "enum": ["news", "program", "report", "feed", "sitemap", "other"] },
          "identity": {
            "type": "object", "additionalProperties": false,
            "required": ["from"],
            "properties": { "from": { "enum": ["feed_guid", "canonical", "url"] } }
          }
        }
      }
    },
    "content_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" }
    },
    "parser_bindings": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
      "additionalProperties": { "type": "string", "pattern": "^(html|xml|pdf|normalize)\\.[a-z0-9_]+@[0-9]+$" }
    },
    "quality_expectations": {
      "type": "object", "additionalProperties": false,
      "required": ["required_fields", "minimum_text_characters", "minimum_item_ratio_to_baseline"],
      "properties": {
        "required_fields": { "type": "array", "items": { "enum": ["canonical_url", "title", "published_at", "updated_at", "language", "body"] } },
        "minimum_text_characters": { "type": "integer", "minimum": 0 },
        "minimum_item_ratio_to_baseline": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "crawl_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_depth", "max_urls_per_run", "requests_per_minute", "timeout_seconds", "max_body_bytes"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_urls_per_run": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "requests_per_minute": { "type": "integer", "minimum": 1, "maximum": 600 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "max_body_bytes": { "type": "integer", "minimum": 1024 },
        "strip_query_params": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": { "type": "object" },
    "discovered_at": { "type": ["string", "null"], "format": "date-time" },
    "last_verified_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "type": ["string", "null"] }
  }
}
